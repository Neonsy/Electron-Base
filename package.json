{
    "name": "electron-vite-react-template",
    "private": true,
    "version": "0.1.0",
    "description": "Base Electron + Vite + React template with tRPC IPC, TanStack Router/Query/Form/Virtual, and TailwindCSS",
    "author": "Example Maintainer <maintainer@example.com>",
    "license": "MIT",
    "homepage": "https://github.com/example-owner/example-electron-app#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/example-owner/example-electron-app.git"
    },
    "bugs": {
        "url": "https://github.com/example-owner/example-electron-app/issues"
    },
    "type": "module",
    "main": "dist-electron/index.js",
    "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
    "engines": {
        "node": "24.21.0",
        "pnpm": "12.6.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsr generate && vite build",
        "build:win": "tsr generate && vite build && electron-builder --win -c electron-builder.config.ts",
        "build:mac": "tsr generate && vite build && electron-builder --mac -c electron-builder.config.ts",
        "build:linux": "tsr generate && vite build && electron-builder --linux -c electron-builder.config.ts",
        "typecheck": "tsr generate && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "tsr generate && eslint .",
        "lint:fix": "tsr generate && eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "tsr generate && vite build && playwright test",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:check": "drizzle-kit check --config drizzle.config.ts",
        "check": "tsr generate && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json && eslint . && prettier --check . && vitest run && drizzle-kit check --config drizzle.config.ts && playwright test --list && vite build"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.104.0",
        "@tanstack/react-router": "^1.170.39",
        "@tanstack/react-virtual": "^3.14.13",
        "@trpc/client": "^11.19.0",
        "@trpc/server": "^11.19.0",
        "@trpc/tanstack-react-query": "^11.19.0",
        "arktype": "^2.2.5",
        "drizzle-orm": "1.0.0-rc.4",
        "electron-updater": "^6.8.9",
        "evlog": "^2.29.0",
        "mutative": "^1.3.0",
        "neverthrow": "^8.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-icons": "^5.7.0",
        "zustand": "^5.0.15",
        "zustand-mutative": "^1.3.1"
    },
    "devDependencies": {
        "@babel/core": "^8.0.6",
        "@electron/fuses": "^2.1.3",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.63.0",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/eslint-plugin-query": "^5.104.0",
        "@tanstack/react-devtools": "^0.10.13",
        "@tanstack/react-form-devtools": "^0.2.34",
        "@tanstack/react-query-devtools": "^5.104.0",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-cli": "^1.167.38",
        "@tanstack/router-plugin": "^1.168.40",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.19.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/eslint-plugin": "^1.6.27",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "1.0.0-rc.4",
        "electron": "^44.4.5",
        "electron-builder": "^26.15.3",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-n": "^18.4.0",
        "eslint-plugin-no-secrets": "^2.3.3",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-security": "^4.1.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwind-clamp": "^4.5.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vite-plugin-electron": "^1.1.2",
        "vitest": "^5.0.2"
    }
}

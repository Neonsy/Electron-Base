# Copy to .env for local-only overrides. Never commit secrets.

# Allow updater checks in an unpackaged development build. Packaged apps always
# enable the updater. A dev check also requires a valid dev-app-update.yml.
UPDATER_ENABLED=0

# Optional structured logging overrides (defaults: enabled and pretty in dev,
# disabled in packaged builds).
EVLOG_ENABLED=1
EVLOG_PRETTY=1
